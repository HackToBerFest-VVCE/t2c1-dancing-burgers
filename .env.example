# Copy to .env and fill in, or run `npm run keygen` to create it. Never commit .env.

# Wallets as JSON arrays of 64 numbers (npm run keygen creates both)
OWNER_PRIVATE_KEY=
ORCHESTRATOR_PRIVATE_KEY=

# LLM for our agents and the planner
ANTHROPIC_API_KEY=

# Contact for Wikipedia's API etiquette (your email or the repo URL), sent in the User-Agent
WIKI_CONTACT=

# LLM=off runs agents on rules instead of Claude (no API credit needed)
LLM=on

# Public base URL of the agent server (registered as each agent's endpoint)
AGENTS_BASE_URL=http://localhost:3001
