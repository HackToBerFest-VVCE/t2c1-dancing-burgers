# Copy to .env and fill in, or run `cd registry && npm run keygen` to create the wallets. Never commit .env.

# Wallets as JSON arrays of 64 numbers: OWNER registers our agents, ORCHESTRATOR writes feedback
OWNER_PRIVATE_KEY=
ORCHESTRATOR_PRIVATE_KEY=

# LLM for the planner, reasoner, verifier and generator: groq (default), openai or gemini. MODEL is optional.
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM=off runs those agents on rules instead (no API cost); the trust layer is the same
LLM=on

# Web search alongside Wikipedia (prices, release dates, recent events). Free key at tavily.com; leave empty for Wikipedia only
TAVILY_API_KEY=

# Contact for Wikipedia's API etiquette (your email or the repo URL), sent in the User-Agent
WIKI_CONTACT=

# Also write scores for SATI-registry agents through SATI's public feedback API (off by default)
SATI_FEEDBACK=off

# Public base URL of the backend (registered as each agent's endpoint)
AGENTS_BASE_URL=http://localhost:3001

# Only for running services outside Docker; compose sets these itself
# DATABASE_URL=postgresql://sworn:sworn@localhost:5432/sworn
# REDIS_URL=redis://localhost:6379/0
# REGISTRY_URL=http://localhost:3002
